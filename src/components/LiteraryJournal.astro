---
import { Image } from "astro:assets";
import RotatingExcerpt from "@/components/RotatingExcerpt.astro";
import PageLayout from "@/layouts/Base.astro";
import { getPostHref } from "@/data/post";
import { render, type CollectionEntry } from "astro:content";
import { createMarkdownProcessor } from "@astrojs/markdown-remark";
import { remarkReadingTime } from "../plugins/remark-reading-time";
import { siteConfig } from "@/site-config";
import { getFormattedDate } from "@/utils/date";
import { withBase } from "@/utils/path";

interface Props {
  posts: CollectionEntry<"post">[];
  title: string;
  prevUrl?: string;
  nextUrl?: string;
}
const { posts, title, prevUrl, nextUrl } = Astro.props;
let countProcessor: ReturnType<typeof createMarkdownProcessor> | undefined;
const characterCounts = new Map(await Promise.all(posts.map(async (post) => {
	if (post.data.externalUrl) return [post.id, undefined] as const;
	const { remarkPluginFrontmatter } = await render(post);
	let count = (remarkPluginFrontmatter as { characterCount?: number }).characterCount;
	if (count === undefined && post.body) {
		countProcessor ??= createMarkdownProcessor({ remarkPlugins: [remarkReadingTime] });
		const result = await (await countProcessor).render(post.body);
		count = result.metadata.frontmatter.characterCount as number | undefined;
	}
	return [post.id, count] as const;
})));
---

<PageLayout meta={{ title, description: siteConfig.description }}>
	<section class="journal" aria-label="随笔">
		<header class="journal-intro">
			<p class="intro-label">DEATH AND THE COMPASS</p>
			<h1>{siteConfig.title}</h1>
			<RotatingExcerpt excerpts={posts.map((post) => post.data.description)} />
		</header>

		{posts.length ? posts.map((post) => (
			<article class="story">
				{post.data.coverImage && (
					<a class="story-cover" href={getPostHref(post)} tabindex="-1" aria-hidden="true">
						<Image src={post.data.coverImage.src} alt="" loading="lazy" />
					</a>
				)}
				<div class="story-content">
					<h2><a href={getPostHref(post)}>{post.data.title}</a></h2>
					<div class="divider" aria-hidden="true"></div>
					<p class="description">{post.data.description}</p>
					<time datetime={post.data.publishDate.toISOString()}>{getFormattedDate(post.data.publishDate)}</time>
					{post.data.tags.length > 0 && (
						<ul class="tags" aria-label="文章标签">
							{post.data.tags.map((tag) => <li><a href={withBase(`/tags/${encodeURIComponent(tag)}/`)}>{tag}</a></li>)}
						</ul>
					)}
					{characterCounts.get(post.id) !== undefined && (
						<p class="character-count">约 {characterCounts.get(post.id)?.toLocaleString("zh-CN")} 字</p>
					)}
				</div>
			</article>
		)) : <p class="empty">这里还没有文章，期待你的第一篇随笔。</p>}
		{(prevUrl || nextUrl) && <nav class="pagination" aria-label="翻页">
			{prevUrl && <a href={prevUrl}>← 上一页</a>}
			{nextUrl && <a href={nextUrl}>下一页 →</a>}
		</nav>}
	</section>
</PageLayout>

<style>
	.journal { padding: 24px 0 64px; }
	.journal-intro { text-align: center; margin: 16px auto 88px; max-width: 34rem; }
	.intro-label { font-family: var(--font-mono); color: hsl(var(--theme-accent)); font-size: 10px; letter-spacing: .2em; margin: 0 0 16px; }
	h1 { font-size: clamp(34px, 6vw, 52px); font-weight: 600; letter-spacing: .16em; line-height: 1.35; margin: 0 0 18px; }
	.intro-text { color: hsl(var(--theme-text-muted)); font-size: 16px; line-height: 1.8; margin: 0; }
	.story { border-top: 1px solid hsl(var(--theme-text) / .16); padding: 64px 0 72px; }
	.story + .story { margin-top: 10px; }
	.story-cover { display: block; overflow: hidden; margin-bottom: 50px; }
	.story-cover :global(img) { display: block; width: 100%; height: auto; max-height: 520px; object-fit: cover; }
	.story-content { text-align: center; max-width: 38rem; margin: 0 auto; }
	h2 { font-size: clamp(23px, 3.3vw, 28px); font-weight: 500; line-height: 1.5; letter-spacing: .06em; margin: 0; }
	h2 a:hover, .tags a:hover { color: hsl(var(--theme-accent)); }
	.divider { width: 42px; height: 1px; background: hsl(var(--theme-accent)); margin: 26px auto; }
	.description { max-width: 34rem; margin: 0 auto 32px; font-size: 17px; line-height: 1.9; color: hsl(var(--theme-text-muted)); }
	time { display: block; font-family: var(--font-mono); font-size: 11px; letter-spacing: .08em; color: hsl(var(--theme-text-muted)); }
	.tags { display: flex; justify-content: center; flex-wrap: wrap; gap: 12px; list-style: none; padding: 0; margin: 12px 0 0; color: hsl(var(--theme-text-muted)); font-size: 13px; }
	.character-count { margin: 14px 0 0; font-size: 13px; letter-spacing: .08em; color: hsl(var(--theme-text-muted)); }
	.pagination { display: flex; justify-content: center; gap: 32px; font-size: 14px; }
	.pagination a:hover { color: hsl(var(--theme-accent)); }
	.empty { text-align: center; color: hsl(var(--theme-text-muted)); }
	@media (max-width: 720px) {
		.journal { padding-top: 12px; }
		.journal-intro { margin-bottom: 56px; }
		.story { padding: 44px 0 52px; }
		.story-cover { margin-bottom: 32px; }
		.description { font-size: 16px; margin-bottom: 24px; }
	}
</style>
